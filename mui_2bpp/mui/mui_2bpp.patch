diff -ru a/mui/mui_u8g2.h b/mui/mui_u8g2.h
--- a/mui/mui_u8g2.h
+++ b/mui/mui_u8g2.h
@@ -68,6 +68,30 @@
 #include "u8g2.h"
 #include "mui.h"
 
+/*
+  Uncomment to multiply the 8 bit x and y position of MUI fields by 1, 2, 4 or 8,
+  so that displays wider or higher than 255 pixel can be filled. Requires U8G2_16BIT.
+*/
+//#define MUI_U8G2_HIRES
+
+/*
+  mui_2bpp: define MUI_U8G2_GRID n to multiply the x and y position of MUI
+  fields by n, whatever the size of the display: with 8, the positions of
+  the forms are in units of 8x8 tiles. Widths given in the arg of a field
+  stay in pixels. If MUI_U8G2_HIRES is defined too, MUI_U8G2_GRID is used.
+*/
+//#define MUI_U8G2_GRID 8
+
+/*
+  mui_2bpp: MUI_U8G2_2BPP (defined by the u8g2.h of mui_2bpp) draws all
+  styles as pi: pf and if as pi, fi as pi with a border (a button); and
+  the checkbox, the radio button and the mark of the chosen value as glyphs
+  of the control font (u8g2_DrawControl()), with a gap of 8 pixels before
+  their text; an option line (opt_line) at the right of its field; a bar
+  (u8_bar, u8_fixed_width_bar) 2/3 of the ascent high, 6 pixels inside the
+  bar of its focus, a full row.
+*/
+
 /*==========================================*/
 /* C++ compatible */
 
