+static void mui_u8g2_draw_opt_line(mui_t *ui, u8g2_uint_t flags)
+{
+  u8g2_t *u8g2 = mui_get_U8g2(ui);
+  u8g2_uint_t x = mui_get_x(ui), y = mui_get_y(ui);
+  u8g2_uint_t w = u8g2_GetUTF8Width(u8g2, ui->text);
+
+  if ( w < ui->arg )
+  {
+    u8g2_DrawUTF8(u8g2, x + ui->arg - w, y, ui->text);
+    w = ui->arg;
+  }
+  else
+    u8g2_DrawUTF8(u8g2, x, y, ui->text);
+  u8g2_DrawButtonFrame(u8g2, x, y, flags, w, 1, MUI_U8G2_V_PADDING);
+}
+#endif
